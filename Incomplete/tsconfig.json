{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "outDir": "dist",
        "rootDir": "src",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "strict": true,
        "resolveJsonModule": true,
        "allowSyntheticDefaultImports": true,
        "noEmitOnError": false,
        "types": ["node"],
        "baseUrl": "src",
        "paths": {
            "@lib/*": ["lib/*"],
            "@core/*": ["core/*"],
            "@type/*": ["type/*"],
            "@utils/*": ["utils/*"]
        }
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
